  "testing": {
    "batch_size": 32,
    "T": 15,
    "correction_step": 0.05,
    "checkpoint": "checkpoints/ENS_HZ.pth",
    "save_reconstruction_loss": "results/test_loss.npy",
    "save_pde_loss": "results/test_pde.npy"
