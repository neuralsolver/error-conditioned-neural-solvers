{
  "seed": 33,
  "device": "auto",
  "data": {
    "training_path": "data/training",
    "testing_path": "data/testing",
    "train_file": null,
    "test_file": null,
    "input_key": "a",
    "u_key": "u"
  },
  "model": {
    "in_channels": 1,
    "out_channels": 20,
    "hidden_channels": 64,
    "n_modes": [20, 20],
    "n_layers": 4
  },
  "pde": {
    "nu": 0.001,
    "dt": 0.2,
    "forcing": "default"
  },
  "training": {
    "batch_size": 48,
    "n_epochs": 20000,
    "learning_rate": 0.0001,
    "weight_decay": 0.0001,
    "pde_weight": 0.01,
    "pde_train_nu": 0.0005,
    "resume_checkpoint": null,
    "save_checkpoint": "checkpoints/128_fno.pth",
    "save_loss": "results/train_loss.npy",
    "print_every": 10,
    "num_workers": 4,
    "pin_memory": true
  },
  "testing": {
    "batch_size": 32,
    "checkpoint": "checkpoints/128_fno.pth",
    "save_reconstruction_loss": "results/test_loss.npy",
    "save_pde_loss": "results/test_pde.npy"
  }
}
